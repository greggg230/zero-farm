{
  "name": "zero-farm-coordinator",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "wrangler types --check && tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "dev": "wrangler dev --ip 0.0.0.0 --port 5400",
    "db:local": "wrangler d1 migrations apply zero-farm --local",
    "db:remote": "wrangler d1 migrations apply zero-farm --remote",
    "deploy": "tsc --noEmit && wrangler d1 migrations apply zero-farm --remote && wrangler deploy",
    "admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/admin.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^22.20.5",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
